  "mapping": {
    "status": "source-backed",
    "note": "Synthetic validator fixture; not an operator implementation.",
    "note_zh": "仅用于 validator 测试的合成夹具，不是算子实现。"
  },
  "trace": {
    "kind": "qkv-head-grouped",
    "refs": {
      "role": "role",
      "wave": "wave",
      "producer_loop": "producer_loop",
      "consumer_loop": "consumer_loop",
      "load": "load",
      "local": "local",
      "direct": "direct",
      "peer_store": "peer_store",
      "fence": "fence",
      "notify": "notify",
      "wait": "wait",
      "consume": "consume",
      "output_store": "output_store"
    },
    "formulas": {
      "lane": "flat_idx % s_wave",
      "task_idx": "flat_idx // s_wave",
      "peer_rank": "task_idx % rank_size",
      "head_group": "task_idx // rank_size",
      "block_id": "wave_start + lane",
      "consumer_flat_idx": "head_group * rank_size * s_wave + source_rank * s_wave + lane",
      "signal_slot": "((block_id % buffer_num) * rank_size + source_rank) * head_groups + head_group",
      "signal_offset": "signal_slot * signal_stride",
      "output_row": "source_rank * sequence_length + block_id * block_s",
      "peer_q": "(block_id % buffer_num) * block_slot_size + source_rank * fused_heads * peer_head_size + head_start * peer_head_size",
      "peer_k": "peer_q + heads_per_rank * peer_head_size",
      "peer_v": "peer_q + 2 * heads_per_rank * peer_head_size",
      "input_offset": "block_id * block_s * stride_a_s + (target_rank * heads_per_rank + head_start) * stride_a_h",
      "output_offset": "output_row * stride_out_s + head_start * stride_out_h"
    },
    "formula_refs": {
      "lane": "lane",
      "task_idx": "task_idx",
      "peer_rank": "target",
      "head_group": "group",
      "block_id": "block",
      "consumer_flat_idx": "consumer_flat",
      "signal_slot": "signal",
      "signal_offset": "signal_offset",
      "output_row": "output_row",
      "peer_q": "peer",
      "peer_k": "peer_k",
      "peer_v": "peer_v",
      "input_offset": "input_offset",
      "output_offset": "output_offset"
    },
    "param_refs": {
      "producer_cores": "role_counts",
      "s_wave": "s_wave",
      "heads_per_group": "group_size",
      "head_groups": "head_groups",
      "block_s": "block_s",
      "block_d": "block_d",
      "signal_stride": "signal_stride",
      "buffer_num": "buffer_num",
      "input_strides": "strides",
      "output_strides": "strides",
      "total_wave_tasks": "total_tasks",
      "mask": "mask"
    }
  },
  "scenarios": [
    {
